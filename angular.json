"build":{"builder":"@angular-devkit/build-angular:application","options":{"outputPath":"dist/movecorp-clone","index":"src/index.html","browser":"src/main.ts","polyfills":["zone.js"],"tsConfig":"tsconfig.app.json","styles":["src/styles.css"]},"configurations":{"production":{"outputHashing":"all"},"development":{"optimization":false,"sourceMap":true}},"defaultConfiguration":"production"},
"serve":{"builder":"@angular-devkit/build-angular:dev-server","configurations":{"production":{"buildTarget":"movecorp-clone:build:production"},"development":{"buildTarget":"movecorp-clone:build:development"}},"defaultConfiguration":"development"}}}}}
